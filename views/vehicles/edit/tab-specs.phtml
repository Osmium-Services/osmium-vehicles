    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bx bx-cog me-2"></i>Extra specs</h5>
                </div>
                <div class="card-body">
                    <div class="form-text mb-3">Anything else worth a label and a value, such as Berths 4, Seats 5 or Length 6.4 m.</div>
